    "@angular/platform-browser": "21.2.25", "rxjs": "7.8.2", "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.25", "@angular/cli": "21.2.25", "@angular/compiler-cli": "21.2.25",
    "@playwright/test": "1.56.1", "@eslint/js": "10.0.1", "eslint": "10.12.0",
    "typescript-eslint": "8.71.1", "jsdom": "27.1.0", "typescript": "5.9.3", "vitest": "4.1.11"
  }
}